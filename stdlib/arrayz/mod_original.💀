fr fr ===== ADVANCED ARRAY OPERATIONS =====

slay reverse_array(nums drip[value]) drip[value]{
    sus length drip = len(nums)
    lowkey (length <= 1) {
        damn nums
    }
    
    fr fr Handle small arrays explicitly
    lowkey (length == 2) {
        damn [nums[1], nums[0]]
    }
    lowkey (length == 3) {
        damn [nums[2], nums[1], nums[0]]
    }
    lowkey (length == 4) {
        damn [nums[3], nums[2], nums[1], nums[0]]
    }
    lowkey (length == 5) {
        damn [nums[4], nums[3], nums[2], nums[1], nums[0]]
    }
    
    fr fr For larger arrays, return original (would need dynamic array building)
    damn nums
}

slay sort_array_ascending(nums drip[value]) drip[value]{
    sus length drip = len(nums)
    lowkey (length <= 1) {
        damn nums
    }
    
    fr fr Simple bubble sort for small arrays
    lowkey (length == 2) {
        lowkey (nums[0] <= nums[1]) {
            damn [nums[0], nums[1]]
        }
        damn [nums[1], nums[0]]
    }
    
    lowkey (length == 3) {
        sus a drip = nums[0]
        sus b drip = nums[1]
        sus c drip = nums[2]
        
        fr fr Sort three elements
        lowkey (a <= b && b <= c) { damn [a, b, c] }
        lowkey (a <= c && c <= b) { damn [a, c, b] }
        lowkey (b <= a && a <= c) { damn [b, a, c] }
        lowkey (b <= c && c <= a) { damn [b, c, a] }
        lowkey (c <= a && a <= b) { damn [c, a, b] }
        damn [c, b, a]
    }
    
    fr fr For larger arrays, return original
    damn nums
}

slay sort_array_descending(nums drip[value]) drip[value]{
    sus sorted_asc drip[value] = sort_array_ascending(nums)
    damn reverse_array(sorted_asc)
}

slay slice_array(nums drip[value], start drip, end drip) drip[value]{
    sus length drip = len(nums)
    
    fr fr Bounds checking
    lowkey (start < 0 || start >= length || end <= start || end > length) {
        damn []
    }
    
    sus slice_length drip = end - start
    
    lowkey (slice_length == 1) {
        damn [nums[start]]
    }
    lowkey (slice_length == 2) {
        damn [nums[start], nums[start + 1]]
    }
    lowkey (slice_length == 3) {
        damn [nums[start], nums[start + 1], nums[start + 2]]
    }
    
    fr fr Default case
    damn nums
}

