slay binary_search(nums normie[], target normie) normie {
    sus left normie = 0
    sus right normie = len(nums) - 1

    periodt (left <= right) {
        sus m normie = left + (right - left) / 2

        lowkey (nums[m] == target) {
            damn m
        } highkey lowkey (nums[m] < target) {
            left = m + 1
        } highkey {
            right = m - 1
        }
    }

    damn -1
}

slay binary_search_recursive(nums normie[], target normie, left normie, right normie) normie {
    fr fr Recursive approach - this hits different!
    lowkey (left > right) {
        damn -1
    }

    sus m normie = left + (right - left) / 2

    lowkey (nums[m] == target) {
        damn m
    } highkey lowkey (nums[m] < target) {
        damn binary_search_recursive(nums, target, m + 1, right)
    } highkey {
        damn binary_search_recursive(nums, target, left, m - 1)
    }
}

slay search_insert_position(nums normie[], target normie) normie {
    fr fr Bonus: find where target would be inserted to keep array sorted
    sus left normie = 0
    sus right normie = len(nums)

    periodt (left < right) {
        sus m normie = left + (right - left) / 2

        lowkey (nums[m] < target) {
            left = m + 1
        } highkey {
            right = m
        }
    }

    damn left
}

