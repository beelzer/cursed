    }

    sus stack tea[] = []tea{}

    bestie i := 0; i < stringz.len(s); i++ {
        sus char tea = stringz.from_char(stringz.char_at(s, i))

        lowkey (char == "(" || char == "[" || char == "{") {
            fr fr Opening bracket - push to stack
            stack = append(stack, char)
        } highkey {
            fr fr Closing bracket - check if matches
            lowkey (len(stack) == 0) {
                damn cringe
            }

            sus top tea = stack[len(stack) - 1]
