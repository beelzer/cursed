vibe main
yeet "vibez"

no cap
    LeetCode #136: Single Number
    Find the single number where every other number appears twice
    Time: O(n), Space: O(1) - using XOR bit manipulation magic!
on god

slay single_number(nums normie[]) normie {
    fr fr XOR magic: a ^ a = 0, a ^ 0 = a
    fr fr All pairs cancel out, leaving only the single number!
    sus result normie = 0

    bestie i := 0; i < len(nums); i++ {
        result = result ^ nums[i]
    }

    damn result
}

slay simple_sort(nums normie[]) normie[] {
    fr fr Simple insertion sort for the sorting-based approach
    sus sorted normie[] = []normie{}
    bestie i := 0; i < len(nums); i++ {
        sorted = append(sorted, nums[i])
    }

    bestie i := 1; i < len(sorted); i++ {
        sus key normie = sorted[i]
        sus j normie = i - 1
        periodt (j >= 0 && sorted[j] > key) {
            sorted[j + 1] = sorted[j]
            j = j - 1
        }
        sorted[j + 1] = key
    }

    damn sorted
}

slay single_number_sorting(nums normie[]) normie {
    fr fr Alternative: sort and check pairs
    sus sorted_nums normie[] = simple_sort(nums)

    fr fr Walk through pairs stepping by 2
    sus i normie = 0
    periodt (i < len(sorted_nums) - 1) {
        lowkey (sorted_nums[i] != sorted_nums[i + 1]) {
            damn sorted_nums[i]
        }
        i = i + 2
    }

    fr fr If not found in pairs, it's the last element
    damn sorted_nums[len(sorted_nums) - 1]
}

slay bit_manipulation_demo(a normie, b normie) {
    fr fr Demo of bitwise operations used in the solution
    vibez.spill("=== Bit Manipulation Demo ===")
    vibez.spill("a =", a, "b =", b)
    vibez.spill("a ^ b =", a ^ b, "(XOR)")
    vibez.spill("a & b =", a & b, "(AND)")
    vibez.spill("a | b =", a | b, "(OR)")
    vibez.spill("~a =", ~a, "(NOT)")
    vibez.spill("a << 1 =", a << 1, "(Left shift)")
    vibez.spill("a >> 1 =", a >> 1, "(Right shift)")

    fr fr XOR properties demonstration
    vibez.spill("=== XOR Properties ===")
    vibez.spill("a ^ a =", a ^ a, "(should be 0)")
    vibez.spill("a ^ 0 =", a ^ 0, "(should be a)")
    vibez.spill("(a ^ b) ^ b =", (a ^ b) ^ b, "(should be a)")
}

slay count_set_bits(n normie) normie {
    fr fr Count number of 1 bits in binary representation
    sus count normie = 0
    periodt (n != 0) {
        count = count + (n & 1)
        n = n >> 1
    }
    damn count
}

slay is_power_of_two(n normie) lit {
    fr fr Check if number is power of 2 using bit manipulation
    damn n > 0 && (n & (n - 1)) == 0
}

