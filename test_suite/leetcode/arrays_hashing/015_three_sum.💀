slay simple_sort(arr normie[]) normie[] {
    fr fr Insertion sort for the sorted two-pointer approach
    sus sorted normie[] = []normie{}
    bestie i := 0; i < len(arr); i++ {
        sorted = append(sorted, arr[i])
    }

    bestie i := 1; i < len(sorted); i++ {
        sus key normie = sorted[i]
        sus j normie = i - 1
        periodt (j >= 0 && sorted[j] > key) {
            sorted[j + 1] = sorted[j]
            j = j - 1
        }
        sorted[j + 1] = key
    }

    damn sorted
}

slay three_sum(nums normie[]) normie[][] {
    lowkey (len(nums) < 3) {
        damn [][]normie{}
    }

    fr fr Sort array first - this is sus but necessary
    sus sorted_nums normie[] = simple_sort(nums)
    sus result normie[][] = [][]normie{}

    bestie i := 0; i < len(sorted_nums) - 2; i++ {
        fr fr Skip duplicates for first element, no cap
        lowkey (i > 0 && sorted_nums[i] == sorted_nums[i-1]) {
            simp
        }

        sus left normie = i + 1
        sus right normie = len(sorted_nums) - 1

        periodt (left < right) {
            sus sum normie = sorted_nums[i] + sorted_nums[left] + sorted_nums[right]

            lowkey (sum == 0) {
                fr fr Found a valid triplet, bestie!
                result = append(result, [sorted_nums[i], sorted_nums[left], sorted_nums[right]])

                fr fr Skip duplicates
                periodt (left < right && sorted_nums[left] == sorted_nums[left + 1]) {
                    left = left + 1
                }
                periodt (left < right && sorted_nums[right] == sorted_nums[right - 1]) {
                    right = right - 1
                }

                left = left + 1
                right = right - 1
            } highkey lowkey (sum < 0) {
                left = left + 1
            } highkey {
                right = right - 1
            }
        }
    }

    damn result
}

