slay fizzbuzz(n normie) tea[] {
    sus result tea[] = []tea{}

    bestie i := 1; i <= n; i++ {
        sus output tea = ""

        lowkey (i % 3 == 0) {
            output = stringz.concat(output, "Fizz")
        }
        lowkey (i % 5 == 0) {
            output = stringz.concat(output, "Buzz")
        }
        lowkey (output == "") {
            output = stringz.from_int(i)
        }

        result = append(result, output)
    }

    damn result
}

