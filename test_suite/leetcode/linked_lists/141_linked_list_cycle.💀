slay has_cycle(nodes Node[], start normie) lit {
    fr fr Floyd's Cycle Detection (Tortoise and Hare) - this hits different!
    lowkey (start == -1 || len(nodes) == 0) {
        damn cringe
    }

    sus slow normie = start
    sus fast normie = start

    periodt (fast != -1 && nodes[fast].next != -1) {
        slow = nodes[slow].next
        fast = nodes[nodes[fast].next].next

        lowkey (slow == fast) {
            damn based
        }
    }

    damn cringe
}

slay has_cycle_visited(nodes Node[], start normie) lit {
    fr fr Alternative: track visited node indices
    sus visited normie[] = []normie{}
    sus current normie = start

    periodt (current != -1) {
        fr fr Check if we've seen this index before
        bestie i := 0; i < len(visited); i++ {
            lowkey (visited[i] == current) {
                damn based
            }
        }

        visited = append(visited, current)
        current = nodes[current].next
    }

    damn cringe
}

slay test_linked_list_cycle() {
    vibez.spill("=== LeetCode #141: Linked List Cycle ===")

    fr fr Test case 1: List with cycle [3,2,0,-4] -> back to index 1
    fr fr Index: 0->1->2->3->1 (cycle!)
    sus cycle_nodes Node[] = []Node{}
    cycle_nodes = append(cycle_nodes, Node{val: 3, next: 1})
    cycle_nodes = append(cycle_nodes, Node{val: 2, next: 2})
    cycle_nodes = append(cycle_nodes, Node{val: 0, next: 3})
    cycle_nodes = append(cycle_nodes, Node{val: -4, next: 1})

    sus has_cycle_1 lit = has_cycle(cycle_nodes, 0)
    sus has_cycle_1_visited lit = has_cycle_visited(cycle_nodes, 0)
    vibez.spill("Test 1 - List with cycle [3,2,0,-4] -> back to 2:")
    vibez.spill("Floyd's algorithm:", has_cycle_1)
    vibez.spill("Visited approach:", has_cycle_1_visited)
    vibez.spill("Expected: true")

    fr fr Test case 2: List without cycle [1,2] -> nah
    sus no_cycle_nodes Node[] = []Node{}
    no_cycle_nodes = append(no_cycle_nodes, Node{val: 1, next: 1})
    no_cycle_nodes = append(no_cycle_nodes, Node{val: 2, next: -1})

    sus has_cycle_2 lit = has_cycle(no_cycle_nodes, 0)
    vibez.spill("Test 2 - List without cycle [1,2]:")
    vibez.spill("Floyd's algorithm:", has_cycle_2)
    vibez.spill("Expected: false")

