    sus has_cycle_3 lit = has_cycle([]Node{}, -1)
    vibez.spill("Test 3 - Empty list:")
    vibez.spill("Result:", has_cycle_3)
    vibez.spill("Expected: false")

    fr fr Test case 4: Single node pointing to itself
    sus self_cycle Node[] = []Node{}
    self_cycle = append(self_cycle, Node{val: 1, next: 0})

    sus has_cycle_4 lit = has_cycle(self_cycle, 0)
    vibez.spill("Test 4 - Single node pointing to itself:")
    vibez.spill("Result:", has_cycle_4)
    vibez.spill("Expected: true")

    vibez.spill("=== Cycle Detection Complete! Floyd's algorithm is sus-piciously good ===")
}

