// LeetCode #704: Binary Search - Backup Implementation
// Find target in sorted array using binary search

slay main_character() {
    vibez.spill("Binary Search Test")

    // Test with simple array
    sus nums normie[] = [1, 3, 5, 7, 9]

    // Test case 1: find existing element
    sus result1 normie = binary_search(nums, 5)
    vibez.spill("Search for 5 in [1,3,5,7,9]:")
    vibez.spill(result1)

    // Test case 2: find missing element
    sus result2 normie = binary_search(nums, 4)
    vibez.spill("Search for 4 in [1,3,5,7,9]:")
    vibez.spill(result2)

    // Test case 3: find first element
    sus result3 normie = binary_search(nums, 1)
    vibez.spill("Search for 1 in [1,3,5,7,9]:")
    vibez.spill(result3)

    // Test case 4: find last element
    sus result4 normie = binary_search(nums, 9)
    vibez.spill("Search for 9 in [1,3,5,7,9]:")
    vibez.spill(result4)

    vibez.spill("Binary search complete")
}

slay binary_search(nums normie[], target normie) normie {
    sus left normie = 0
    sus right normie = len(nums) - 1

    periodt (left <= right) {
        sus middle normie = left + (right - left) / 2

        ready (nums[middle] == target) {
            damn middle
        } otherwise ready (nums[middle] < target) {
            left = middle + 1
        } otherwise {
            right = middle - 1
        }
    }

    damn -1
}
