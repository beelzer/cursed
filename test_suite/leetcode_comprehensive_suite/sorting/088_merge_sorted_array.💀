// LeetCode #88: Merge Sorted Array
// Merge two sorted arrays into one sorted array
// Time: O(m+n), Space: O(m+n) - returns new merged array

slay merge(nums1 normie[], m normie, nums2 normie[], n normie) normie[] {
    // Two-pointer merge into a new result array
    sus result normie[] = []normie{}
    sus i normie = 0
    sus j normie = 0

    // Merge while both arrays have elements
    periodt (i < m && j < n) {
        lowkey (nums1[i] <= nums2[j]) {
            append(result, nums1[i])
            i = i + 1
        } highkey {
            append(result, nums2[j])
            j = j + 1
        }
    }

    // Copy remaining elements from nums1
    periodt (i < m) {
        append(result, nums1[i])
        i = i + 1
    }

    // Copy remaining elements from nums2
    periodt (j < n) {
        append(result, nums2[j])
        j = j + 1
    }

    damn result
}

