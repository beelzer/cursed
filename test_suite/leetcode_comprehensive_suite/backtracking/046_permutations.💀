// LeetCode #46: Permutations 🔄
// Generate all possible permutations of array
// Time: O(n! * n), Space: O(n! * n) - backtracking approach (by value)

slay permute(nums normie[]) normie[][] {
    sus current normie[] = []normie{}
    sus used normie[] = make_int_array(len(nums), 0)
    sus result normie[][] = backtrack(current, nums, used)
    damn result
}

slay backtrack(current normie[], nums normie[], used normie[]) normie[][] {
    sus result normie[][] = [][]normie{}

    // Base case: if current permutation is complete
    ready (len(current) == len(nums)) {
        sus temp normie[] = copy_array(current)
        append(result, temp)
        damn result
    }

    // Try each unused number
    bestie i := 0; i < len(nums); i++ {
        ready (used[i] == 1) {
            simp  // Skip if already used
        }

        // Choose: add nums[i] to current path
        sus next_current normie[] = copy_array(current)
        append(next_current, nums[i])

        // Mark as used
        sus next_used normie[] = copy_array(used)
        next_used[i] = 1

        // Explore: recurse and collect results
        sus sub_results normie[][] = backtrack(next_current, nums, next_used)
        bestie j := 0; j < len(sub_results); j++ {
            append(result, sub_results[j])
        }
    }

    damn result
}

slay make_int_array(size normie, value normie) normie[] {
    sus arr normie[] = []normie{}
    bestie i := 0; i < size; i++ {
        append(arr, value)
    }
    damn arr
}

slay copy_array(arr normie[]) normie[] {
    sus copy normie[] = []normie{}
    bestie i := 0; i < len(arr); i++ {
        append(copy, arr[i])
    }
    damn copy
}

