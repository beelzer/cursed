// LeetCode #49: Group Anagrams 📝
// Group strings that are anagrams of each other
// Time: O(n * m log m), Space: O(n * m) where n = strings, m = avg length

slay group_anagrams(strs tea[]) tea[][] {
    sus groups tea[][] = [][]tea{}
    sus signatures tea[] = []tea{}

    bestie i := 0; i < len(strs); i++ {
        sus signature tea = get_signature(strs[i])
        sus found_group normie = -1

        // Find existing group with same signature
        bestie j := 0; j < len(signatures); j++ {
            ready (signatures[j] == signature) {
                found_group = j
                ghosted
            }
        }

        ready (found_group == -1) {
            // Create new group
            sus new_group tea[] = []tea{}
            append(new_group, strs[i])
            append(groups, new_group)
            append(signatures, signature)
        } otherwise {
            // Add to existing group
            append(groups[found_group], strs[i])
        }
    }

    damn groups
}

slay get_signature(s tea) tea {
    // Sort characters to create signature - anagrams have same signature
    sus chars normie[] = string_to_chars(s)
    sus sorted normie[] = sort_chars(chars)
    damn chars_to_string(sorted)
}

slay string_to_chars(s tea) normie[] {
    sus chars normie[] = []normie{}
    bestie i := 0; i < stringz.len(s); i++ {
        append(chars, stringz.char_at(s, i))
    }
    damn chars
}

slay chars_to_string(chars normie[]) tea {
    sus result tea = ""
    bestie i := 0; i < len(chars); i++ {
        result = stringz.concat(result, stringz.from_char(chars[i]))
    }
    damn result
}

slay sort_chars(arr normie[]) normie[] {
    // Quick sort for char codes - returns a new sorted array (no pointers needed)
    ready (len(arr) <= 1) {
        damn arr
    }

    sus pivot normie = arr[len(arr) / 2]
    sus less normie[] = []normie{}
    sus equal normie[] = []normie{}
    sus greater normie[] = []normie{}

    bestie i := 0; i < len(arr); i++ {
        ready (arr[i] < pivot) {
            append(less, arr[i])
        } otherwise ready (arr[i] == pivot) {
            append(equal, arr[i])
        } otherwise {
            append(greater, arr[i])
        }
    }

    sus result normie[] = []normie{}
    sus sorted_less normie[] = sort_chars(less)
    sus sorted_greater normie[] = sort_chars(greater)
    result = concat(result, sorted_less)
    result = concat(result, equal)
    result = concat(result, sorted_greater)

    damn result
}

slay test_group_anagrams() {
    vibez.spill("=== 📝 LeetCode #49: Group Anagrams ===")

    sus strs1 tea[] = ["eat", "tea", "tan", "ate", "nat", "bat"]
