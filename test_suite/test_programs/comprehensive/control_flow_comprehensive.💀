Comprehensive Control Flow Test  
Tests: if/else chains, nested conditions, while loops
Expected: All control structures work identically in both modes
on god

slay main_character() {
    vibez.spill("=== Comprehensive Control Flow Test ===")
    
    fr fr Test basic if statements
    sus value normie = 15
    lowkey (value > 10) {
        vibez.spill("Value is greater than 10")
    } highkey {
        vibez.spill("Value is 10 or less")
    }
    
    fr fr Test if-else chain
    sus grade normie = 75
    lowkey (grade >= 90) {
        vibez.spill("Grade: A")
    } highkey lowkey (grade >= 80) {
        vibez.spill("Grade: B") 
    } highkey lowkey (grade >= 70) {
        vibez.spill("Grade: C")
    } highkey {
        vibez.spill("Grade: F")
    }
    
    fr fr Test nested conditions
    sus x normie = 12
    sus y normie = 8
    lowkey (x > 10) {
        lowkey (y < 10) {
            vibez.spill("Both conditions met")
        } highkey {
            vibez.spill("Only first condition met")
        }
    } highkey {
        vibez.spill("First condition not met")
    }
    
    fr fr Test boolean operations
    sus a normie = 5
    sus b normie = 3
    lowkey (a > b) {
        vibez.spill("Boolean test passed")
    }
    
    vibez.spill("=== Control Flow Test Complete ===")
}
