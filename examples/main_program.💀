vibe main_program

no cap
Import utilities from other packages
yeet "package1"
yeet "package2"
on god

slay main_character() {
    vibez.spill("Multi-package CURSED program")
    
    no cap
    Test mathematical operations
    sus sum = package1.add(10, 5)
    sus product = package1.multiply(4, 7)
    sus power_result = package1.power(2, 3)
    on god
    
    no cap
    vibez.spill("10 + 5 =", sum)
    vibez.spill("4 * 7 =", product) 
    vibez.spill("2^3 =", power_result)
    on god
    
    fr fr Test array operations
    sus numbers = []normie{3, 1, 4, 1, 5, 9, 2, 6}
    no cap
    sus reversed = package2.reverse_array(numbers)
    sus total = package2.sum_array(numbers)
    sus maximum = package2.find_max(numbers)
    on god
    
    no cap
    vibez.spill("Original array:", numbers)
    vibez.spill("Reversed array:", reversed)
    vibez.spill("Sum:", total)
    vibez.spill("Maximum:", maximum)
    on god
    
    no cap
    Test conditional logic
    issa package1.is_even(total) {
        vibez.spill("Sum is even")
    } else {
        vibez.spill("Sum is odd")
    }
    on god
    
    vibez.spill("Program completed successfully!")
}
